    <string name="purge_now">Erase now</string>
    <string name="purge_done">Old versions erased</string>

    <string name="reclaim_title">Free up space</string>
    <string name="reclaim_hint">Deleted and replaced entries of this vault leave placeholder blocks behind so the file never shrinks. Removing them makes the file smaller, which someone comparing two copies of it could notice.</string>
